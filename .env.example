# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to authorize on-demand revalidation calls
REVALIDATE_SECRET=generate-a-long-random-string

# Canonical site URL (used for sitemap / OG / email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (appointment confirmations) — resend.com, free tier
# Without a key, bookings still work and appear in the admin; emails are skipped.
RESEND_API_KEY=
# Verified sender. For testing you can use: Premium Choice School Trips <onboarding@resend.dev>
RESEND_FROM=
# Where internal "new appointment" notifications go (optional)
APPOINTMENT_NOTIFY_EMAIL=info@premiumchoicetravel.com

# Claude API key (console.anthropic.com) — powers the travel app's live
# translator. Without it, the Translate tab shows a friendly "not configured"
# message; everything else works.
ANTHROPIC_API_KEY=

# Anti-spam on the appointment form (lib/spam-guard.ts).
# Cloudflare Turnstile is free: one widget can list every Premium Choice
# hostname, so the same two keys serve this site and the main one.
# Until the secret is set the challenge is skipped and the other checks carry it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the "form was opened at" stamp. Optional: falls back to the service-role key.
FORM_STAMP_SECRET=
